# If the whole project folder is web-accessible (e.g. htdocs/rtti), send visitors to /public
# and block direct access to application folders.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|config|database|storage|docs)(/|$) - [F,L]
  RewriteCond %{REQUEST_FILENAME} !/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
