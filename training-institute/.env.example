# RTTI Management System - copy to .env (never commit .env)
APP_NAME="RTTI Management System"
APP_ENV=production          # local | production
APP_DEBUG=false
APP_URL=http://localhost/training-institute/public
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn               # bn | en
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rtti_management
DB_USERNAME=rtti_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_NAME=RTTI_SESSID
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
SESSION_SECURE_COOKIE=auto
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TRUSTED_PROXIES=
UPLOAD_MAX_MB=5
