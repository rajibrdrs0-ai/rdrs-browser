# ---------------------------------------------------------------
# Courier Management সার্ভিস - Environment Configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------
APP_NAME="Courier Management সার্ভিস"
APP_ENV=production          # local | staging | production
APP_DEBUG=false             # true only on local machines
APP_URL=http://localhost/courier-management/public
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn               # bn | en  (default interface language)
APP_FALLBACK_LOCALE=en
# Generate with:  php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Database (MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=courier_management
DB_USERNAME=cms_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session & security
SESSION_NAME=CMS_SESSID
SESSION_IDLE_TIMEOUT=1800       # seconds of inactivity before logout
SESSION_ABSOLUTE_TIMEOUT=43200  # hard limit for one session (12h)
SESSION_SECURE_COOKIE=auto      # auto | true | false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TRUSTED_PROXIES=                # comma separated IPs of load balancers / reverse proxies

# Tracking number format: PREFIX-YYYYMMDD-XXXXXX
TRACKING_PREFIX=CMS

# File uploads
UPLOAD_MAX_MB=5
